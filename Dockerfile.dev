FROM node:20-alpine

WORKDIR /app

COPY package.json package-lock.json ./
COPY backend/package.json ./backend/
COPY frontend/package.json ./frontend/

RUN npm ci

COPY backend ./backend
COPY frontend ./frontend

ENV GPX_MERGE_DEV=1
ENV VITE_DEV_URL=http://127.0.0.1:5173
ENV PORT=3000

EXPOSE 3000

CMD ["npm", "run", "dev"]
